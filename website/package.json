{
  "name": "@chimera-camera/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation website for Chimera Camera.",
  "author": "Chimera Camera contributors",
  "scripts": {
    "docs": "fumadocs-mdx",
    "docs:typedoc": "echo \"TypeDoc generation is disabled until the Chimera Camera typedoc pipeline exists.\"",
    "check:links": "pnpm run docs && node ./scripts/run-verify-links.mjs",
    "build": "pnpm run check:links && next build",
    "dev": "pnpm run docs && next dev",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "clean": "rm -rf .next .source",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "test:logic": "vitest run ./src",
    "test:screenshots": "playwright test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@r4ai/remark-callout": "^0.6.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.9.2",
    "fumadocs-docgen": "3.0.10",
    "fumadocs-mdx": "15.0.9",
    "fumadocs-ui": "16.9.2",
    "lucide-react": "1.17.0",
    "motion": "12.40.0",
    "next": "16.2.12",
    "picocolors": "^1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/unist": "^3.0.3",
    "esbuild": "^0.28.1",
    "github-slugger": "^2.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "postcss": "8.5.23",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "4.3.0",
    "ts-morph": "28.0.0",
    "typedoc": "0.28.19",
    "typedoc-plugin-frontmatter": "1.3.1",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  }
}