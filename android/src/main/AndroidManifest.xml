<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest fragment for the Chimera Camera Android sources. The host
  app merges these permissions, the transparent proxy activity, and the
  FileProvider. Confirm the FileProvider authority matches the one used in
  ChimeraProxyActivity ("$packageName.chimeracamera.fileprovider").
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- saveToLibrary only: API 29+ uses scoped storage and needs no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name="com.kealanau.chimeracamera.ChimeraProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.chimeracamera.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chimera_camera_file_paths" />
        </provider>
    </application>
</manifest>
