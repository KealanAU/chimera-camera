{
  "name": "@vyui/chimera-camera",
  "version": "0.0.1",
  "description": "A Lynx-native camera surface with plain TypeScript APIs and native iOS/Android hooks.",
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KealanAU/chimera-camera.git"
  },
  "homepage": "https://github.com/KealanAU/chimera-camera#readme",
  "keywords": [
    "lynx",
    "camera",
    "ios",
    "android",
    "native-module"
  ],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "ChimeraCamera.podspec",
    "ios",
    "android",
    "docs",
    "example",
    "images",
    "README.md",
    "INSTALLATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "!docs/archive",
    "!images/src",
    "!example/**/dist",
    "!example/**/node_modules"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "pnpm --filter @chimera-camera/react --filter @chimera-camera/vue run typecheck",
    "build": "tsc -p tsconfig.json",
    "bump": "node scripts/bump-patch.mjs",
    "pretest": "pnpm run build",
    "test": "node --test 'tests/*.test.js'"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
